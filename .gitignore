*.pyc
.DS_Store
# Local reviewer identity; the tracked template is project.example.toml.
project.toml
# Risk data stays local; tmreg creates it. .githooks/ refuses it even when forced.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
systems/*/register*.md
systems/*/runs/
systems/*/inputs/
systems/*/threat-model.md
systems/*/dfd.md
# Each system's C4 model is risk data too, except the reference system's, which is the made-up
# example the modeling agent copies. Structurizr's JSON and the exported diagrams stay local.
systems/*/workspace.dsl
!systems/ordering-platform/workspace.dsl
systems/*/workspace.json
/diagrams/

# Web app build output and local tool scratch; never risk data.
webapp/backend/.venv/
webapp/frontend/node_modules/
webapp/frontend/dist/
.superpowers/
