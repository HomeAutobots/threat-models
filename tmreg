#!/usr/bin/env python3
"""Entry script for the threat-model registry. The version check runs before any tmreg import."""
import sys

if sys.version_info < (3, 11):
    sys.stderr.write(f"tmreg needs Python 3.11 or later (for tomllib); this is "
                     f"{sys.version.split()[0]}. Use Homebrew's python3.\n")
    sys.exit(1)

from pathlib import Path  # noqa: E402

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "registry"))

from tmreg.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:], project_root=ROOT))
